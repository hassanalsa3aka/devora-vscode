{
  "name": "devora-vscode",
  "displayName": "Devora.js",
  "description": "Snippets and CLI commands for Devora.js projects",
  "version": "0.0.1",
  "publisher": "hassansayed",
  "author": "Devora.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanalsa3aka/devora-vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devora.startDevServer",
        "title": "Devora: Start Dev Server",
        "category": "Devora"
      },
      {
        "command": "devora.buildApp",
        "title": "Devora: Build App",
        "category": "Devora"
      },
      {
        "command": "devora.newApp",
        "title": "Devora: New App",
        "category": "Devora"
      },
      {
        "command": "devora.newRoute",
        "title": "Devora: New Route",
        "category": "Devora"
      }
    ],
    "snippets": [
      {
        "language": "typescriptreact",
        "path": "./snippets/route.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/serverfn.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "esbuild": "^0.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
